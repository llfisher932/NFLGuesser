generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One login. Predictions belong to the user, not to an organization, so the
/// same slate counts on every leaderboard they appear on.
model User {
  id           Int      @id @default(autoincrement())
  /// Always stored lowercase; sign-in is case-insensitive.
  username     String   @unique
  displayName  String
  passwordHash String
  isAdmin      Boolean  @default(false)
  /// Part of the session cookie. Bumping it signs the user out everywhere,
  /// which happens whenever their password changes.
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())

  memberships Membership[]
  predictions Prediction[]
}

/// A friend group with its own leaderboard. `code` is an internal identifier
/// only the admin sees; users never type it.
model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  memberships Membership[]
}

model Membership {
  userId         Int
  organizationId Int
  joinedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
  /// Postponed or canceled. Never scored.
  CANCELED
}

/// One week of the NFL calendar, copied from ESPN. seasonType 2 is the regular
/// season, 3 the postseason (week 1 = Wild Card ... week 4 = Super Bowl).
model Week {
  season     Int
  seasonType Int
  week       Int
  label      String
  startDate  DateTime
  endDate    DateTime

  @@id([season, seasonType, week])
}

model Game {
  id         Int        @id @default(autoincrement())
  espnId     String     @unique
  season     Int
  seasonType Int
  week       Int
  kickoff    DateTime
  status     GameStatus @default(SCHEDULED)
  /// ESPN's short status, e.g. "Q3 4:12" or "Final/OT".
  statusDetail String?

  homeTeam  String
  homeName  String
  homeLogo  String?
  homeColor String?
  homeRecord String?
  homeScore Int?

  awayTeam  String
  awayName  String
  awayLogo  String?
  awayColor String?
  awayRecord String?
  awayScore Int?

  /// Set when the admin edits the result by hand. Syncs then leave the score
  /// and status alone, so an override is never silently undone.
  manualResult Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  predictions Prediction[]

  @@index([season, seasonType, week])
}

model Prediction {
  userId    Int
  gameId    Int
  homeScore Int
  awayScore Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
}

/// When something was last pulled from ESPN, keyed by what it was
/// ("calendar", "week:2026:2:9"). This is what makes syncing lazy: a read
/// refreshes its data only once it is older than it's allowed to be.
model SyncState {
  key      String   @id
  syncedAt DateTime
}
