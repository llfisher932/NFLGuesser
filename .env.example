# Copy to .env at the repo root (server/.env also works and wins if present);
# set the same keys as Environment Variables in the Vercel project
# (Production + Preview + Development).

# Postgres connection string. Locally this is the PostgreSQL 18 install; on
# Vercel use a hosted, pooled URL with ?sslmode=require. Migrations need a
# direct (non-pgbouncer) connection.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nflguesser"

# Secret used to sign the session cookie. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# The admin account the seed creates. Only read by `npm run db:seed`.
ADMIN_USERNAME="logan"
ADMIN_DISPLAY_NAME="Logan"

# Local dev only. Vercel sets the port itself.
PORT=3010
